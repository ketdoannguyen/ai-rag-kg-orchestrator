# =========================================================================
# Local data services — shared by the host application and docker/docker-compose.yml
# =========================================================================
# Copy this file to `.env` and replace every <placeholder> before starting anything.
# The same file configures the host app and the local containers:
#   docker compose --env-file .env -f docker/docker-compose.yml up -d arangodb minio
ARANGO_URL=http://localhost:8529
ARANGO_DATABASE=knowledge_db
ARANGO_USER=root
ARANGO_PASSWORD=<set-a-local-root-password>

# ARANGO_PASSWORD / MINIO_ACCESS_KEY / MINIO_SECRET_KEY are also consumed by the
# containers as their root credentials, so use values without spaces or quotes.
# Port 9002, not MinIO's usual 9000: another Compose project on this machine
# (vku-science-infra) already publishes 127.0.0.1:9000. Keep this in step with the
# host port mapping in docker/docker-compose.yml.
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=<set-a-local-access-key>
MINIO_SECRET_KEY=<set-a-local-secret-key>
MINIO_BUCKET=ingest
MINIO_KNOWLEDGE_BUCKET=knowledge-files

REDIS_URL=redis://localhost:6379/0

# =========================================================================
# LLM Gateway Configuration
# =========================================================================
# Single API key and base URL for all LLM/embedding calls
LLM_API_KEY=sk-or-...
LLM_API_BASE=https://openrouter.ai/api/v1

LLM_CHAT_MODEL=openai/qwen/qwen3-next-80b-a3b-instruct
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Optional: separate config for chat vs embedding (if using different providers)
# LLM_CHAT_API_KEY=sk-...
# LLM_CHAT_API_BASE=https://api.openai.com/v1
# LLM_EMBEDDING_API_KEY=sk-...
# LLM_EMBEDDING_API_BASE=https://api.openai.com/v1

# =========================================================================
# Vision OCR (workflows/ingest_file)
# =========================================================================
# OpenAI-compatible chat-completions endpoint that transcribes PDF pages.
# The key is read from the environment only: never logged, never persisted.
# VISION_API_BASE must point at a host listed in VISION_ALLOWED_HOSTS, otherwise
# the client refuses to send VISION_API_KEY at all.
VISION_API_BASE=https://opencode.ai/zen/go/v1/chat/completions
VISION_API_KEY=<set-a-vision-api-key>
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_ALLOWED_HOSTS=opencode.ai
# Extra request headers as JSON. An "Authorization" entry is ignored on purpose.
# opencode.ai REQUIRES a stable session id here: without it every request comes
# back "HTTP 400 MissingSessionID". It only affects routing and prompt caching,
# so any stable string works.
VISION_HEADERS={"x-opencode-session":"<any-stable-session-id>"}
VISION_IMAGE_DETAIL=high
VISION_DPI=200
VISION_TEMPERATURE=0.0
# The model is a reasoning model: it spends max_tokens on hidden reasoning before
# emitting any content, so a ceiling that looks generous can still come back empty
# (finish_reason=length, 0 characters). VISION_REASONING_EFFORT=none turns that
# reasoning off, which measured ~8x fewer output tokens per page with no loss of
# transcription fidelity. Use low/medium/high to buy reasoning back, or leave the
# value empty to send no hint at all.
VISION_REASONING_EFFORT=none
VISION_MAX_TOKENS=8000
VISION_MAX_BLOCKS_PER_PAGE=400
# Printed page = physical PDF page + VISION_PAGE_OFFSET
VISION_PAGE_OFFSET=0

# =========================================================================
# Langfuse Cloud Observability (optional)
# =========================================================================
# Get keys from https://cloud.langfuse.com project settings
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_OTEL_HOST=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true
